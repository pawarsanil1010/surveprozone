@{
    ViewData["Title"] = "Automation Systems";
}

<div class="container-fluid mt-5">

    <div class="row align-items-center">

        <!-- LEFT SIDE: TEXT -->
        <div class="col-lg-6 px-5" data-aos="fade-right">

            <h2 class="fw-bold mb-3">⚙️ Automation Systems</h2>

            <p class="lead">
                Automate your security with smart gate and barrier systems.
            </p>

            <ul class="list-unstyled mt-4">
                <li class="mb-2">✔ <strong>Boom Barriers</strong></li>
                <li class="mb-2">✔ Gate Motors</li>
                <li class="mb-2">✔ Video Door Phones</li>
                <li class="mb-2">✔ Smart Home Integration</li>
            </ul>

            <a href="/Contact" class="btn btn-primary mt-3">Request Quote</a>

        </div>

        <!-- RIGHT SIDE: IMAGE GRID -->
        <div class="col-lg-6 p-4" data-aos="fade-left">

            <div class="row g-3">

                <div class="col-6">
                    <img src="/images/boom-barrier.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/Gate-motor.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/videogate.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/homeintigration.jpg" class="img-fluid rounded shadow service-img" />
                </div>

            </div>

        </div>

    </div>

</div>