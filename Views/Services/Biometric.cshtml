@{
    ViewData["Title"] = "Biometric Systems";
}

<div class="container-fluid mt-5">

    <div class="row align-items-center">

        <!-- LEFT SIDE: TEXT -->
        <div class="col-lg-6 px-5" data-aos="fade-right">

            <h2 class="fw-bold mb-3">🔐 Biometric & Access Control</h2>

            <p class="lead">
                Secure your premises with advanced biometric and access control systems.
            </p>

            <ul class="list-unstyled mt-4">
                <li class="mb-2">✔ <strong>Fingerprint Attendance</strong></li>
                <li class="mb-2">✔ RFID Card Systems</li>
                <li class="mb-2">✔ Face Recognition</li>
                <li class="mb-2">✔ Door Access Control</li>
            </ul>

            <a href="/Contact" class="btn btn-primary mt-3">Request Quote</a>

        </div>

        <!-- RIGHT SIDE: IMAGE GRID -->
        <div class="col-lg-6 p-4" data-aos="fade-left">

            <div class="row g-3">

                <div class="col-6">
                    <img src="/images/fing.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/RFID.webp" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/face.webp" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/door.jpg" class="img-fluid rounded shadow service-img" />
                </div>

            </div>

        </div>

    </div>

</div>