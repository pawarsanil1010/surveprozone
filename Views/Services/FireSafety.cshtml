@{
    ViewData["Title"] = "Fire Safety";
}

<div class="container-fluid mt-5">

    <div class="row align-items-center">

        <!-- LEFT SIDE: TEXT -->
        <div class="col-lg-6 px-5" data-aos="fade-right">

            <h2 class="fw-bold mb-3">🔥 Fire Safety Systems</h2>

            <p class="lead">
                Protect your property with reliable fire safety and alarm systems.
            </p>

            <ul class="list-unstyled mt-4">
                <li class="mb-2">✔ <strong>Fire Alarm Systems</strong></li>
                <li class="mb-2">✔ Smoke Detectors</li>
                <li class="mb-2">✔ Emergency Alert Systems</li>
                <li class="mb-2">✔ Installation & AMC</li>
            </ul>

            <a href="/Contact" class="btn btn-primary mt-3">Request Quote</a>

        </div>

        <!-- RIGHT SIDE: IMAGE GRID -->
        <div class="col-lg-6 p-4" data-aos="fade-left">

            <div class="row g-3">

                <div class="col-6">
                    <img src="/images/firealarm.webp" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/smoke.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/fire-alarm-systems.jpg" class="img-fluid rounded shadow service-img" />
                </div>

                <div class="col-6">
                    <img src="/images/fireservice.webp" class="img-fluid rounded shadow service-img" />
                </div>

            </div>

        </div>

    </div>

</div>