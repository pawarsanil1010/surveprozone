@model SurveProzone.Models.SiteContent
@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="bg-dark text-white text-center p-5">
    <h1 data-aos="fade-up" data-aos-delay="200"
        class="display-4 fw-bold">
        @Model?.HeroTitle
    </h1>

    <p data-aos="fade-up" data-aos-delay="300"
       class="lead">
        @Model?.HeroSubtitle
    </p>

    <a data-aos="zoom-in" data-aos-delay="400"
       href="/Contact"
       class="btn btn-primary">
        @Model?.ButtonText
    </a>
    </div>
<div id="mainSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">

    <div class="carousel-inner">

        <!-- Slide 1 -->
        <div class="carousel-item active">
            <img src="/images/CCTV4.jpg" class="d-block w-100 slider-img">
            <div class="overlay"></div>

            <div class="carousel-caption text-start">
                <h1 class="fw-bold">CCTV Surveillance</h1>
                <p>Protect your home & business with smart security</p>
                <a href="/Contact" class="btn btn-primary">Get Quote</a>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item">
            <img src="/images/biometric.webp" class="d-block w-100 slider-img">
            <div class="overlay"></div>

            <div class="carousel-caption text-start">
                <h1 class="fw-bold">Biometric Systems</h1>
                <p>Advanced access control solutions</p>
                <a href="/Contact" class="btn btn-primary">Get Quote</a>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-item">
            <img src="/images/automation.jpg" class="d-block w-100 slider-img">
            <div class="overlay"></div>

            <div class="carousel-caption text-start">
                <h1 class="fw-bold">AMC Services</h1>
                <p>Reliable maintenance & support</p>
                <a href="/Contact" class="btn btn-primary">Get Quote</a>
            </div>
        </div>
        <!-- Slide 4 -->
        <div class="carousel-item">
            <img src="/images/fire.jpg" class="d-block w-100 slider-img">
            <div class="overlay"></div>

            <div class="carousel-caption text-start">
                <h1 class="fw-bold">🔥 Fire Safety Systems</h1>
                <p>Advanced fire detection & alarm solutions</p>
                <a href="/Contact" class="btn btn-primary">Get Quote</a>
            </div>
        </div>

    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" data-bs-target="#mainSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" data-bs-target="#mainSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>
<!-- SERVICES -->
<div class="container-fluid py-5">

    <!-- TITLE -->
    <div class="text-center mb-5" data-aos="fade-up">
        <h1 class="fw-bold">Our Core Services</h1>
        <h3 class="text-muted">Smart security solutions for modern businesses</h3>
    </div>

    <div class="row g-4 px-4">

        <!-- CCTV -->
        <div class="col-lg-3 col-md-6" data-aos="zoom-in">
            <a href="/Services/CCTV" class="text-decoration-none">
                <div class="service-card">
                    <img src="/images/CCTV4.jpg" />

                    <div class="service-title">
                        <h5>📹 CCTV Surveillance</h5>
                    </div>

                    <div class="overlay">
                        <p>24/7 monitoring solutions</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- BIOMETRIC -->
        <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="100">
            <a href="/Services/Biometric" class="text-decoration-none">
                <div class="service-card">
                    <img src="/images/biometric.webp" />

                    <div class="service-title">
                        <h5>🔐 Access Control</h5>
                    </div>

                    <div class="overlay">
                        <p>Biometric & RFID systems</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- FIRE -->
        <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="200">
            <a href="/Services/FireSafety" class="text-decoration-none">
                <div class="service-card">
                    <img src="/images/fire.jpg" />

                    <div class="service-title">
                        <h5>🔥 Fire Safety</h5>
                    </div>

                    <div class="overlay">
                        <p>Alarm & detection systems</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- AUTOMATION -->
        <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="300">
            <a href="/Services/Automation" class="text-decoration-none">
                <div class="service-card">
                    <img src="/images/automation.jpg" />

                    <div class="service-title">
                        <h5>⚙️ Automation</h5>
                    </div>

                    <div class="overlay">
                        <p>Smart gate & barrier systems</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

</div><!-- WHY CHOOSE US -->
<div class=" mt-5 p-5 text-center">
    <h2>Why Choose Us?</h2>
    <p>Professional installation, quick support, and affordable pricing.</p>
</div>